{
  "manifest_version": "0.2",
  "name": "pinokio-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling Pinokio - the 1-click localhost cloud for AI apps",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/pinokio_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","pinokio_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "app_management", "description": "app_management" }
  ]
}
